# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=

# Your KooKoo SIP number (used inside the <stream> tag)
SIP_NUMBER=1

PORT=3000

# AI models (defaults below — all available on your Groq key)
BRAIN_MODEL=qwen/qwen3.8-27b
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=hannah
BRAIN_MAX_TOKENS=160

# Voice agent behaviour
GREETING=Hello, thank you for calling. How can I help you today?
# Custom system prompt (optional; overrides built-in receptionist prompt)
#SYSTEM_PROMPT=

# VAD tuning
VAD_THRESHOLD=300
VAD_SILENCE_MS=800
MAX_UTTERANCE_SECONDS=30

# Deployment: set PUBLIC_URL or RAILWAY_PUBLIC_DOMAIN to the https URL of the app,
# otherwise the stream URL is derived from the incoming request host.
#PUBLIC_URL=https://your-app.up.railway.app
# Live-agent transfer (Stream webhook -> <cctransfer>). Leave TRANSFER_SKILL empty
# to disable: the bot then always ends the call with <hangup>.
#TRANSFER_SKILL=SalesSkill
#TRANSFER_UUI=voicebot
#TRANSFER_TIMEOUT=30
#TRANSFER_RING_TYPE=ring
#TRANSFER_MOH=https://example.com/moh.mp3
#TRANSFER_HOLD_MUSIC=https://example.com/hold.mp3
